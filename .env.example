# Copy this file to .env and fill in your values. .env is gitignored.

# eBay Browse API: Production keyset from https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional eBay settings (defaults shown). Use EBAY_ENV=sandbox with a Sandbox keyset.
# EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_ENV=production

# Optional: PriceCharting API token (paid subscription) for pc_cost.py
# PRICECHARTING_TOKEN=

# Optional: Discord webhook for deal alerts from main.py
# DISCORD_WEBHOOK_URL=
